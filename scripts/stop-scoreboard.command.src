#!/bin/bash
# Desktop launcher: stops the scoreboard server and removes it from launchd
# supervision (so it stays stopped instead of auto-restarting).

LABEL="__LABEL__"
UID_GUI="gui/$(id -u)"

echo "Colorado Scoreboard - Stop"
echo "----------------------------"

if launchctl print "$UID_GUI/$LABEL" >/dev/null 2>&1; then
    launchctl bootout "$UID_GUI/$LABEL"
    echo "Stopped."
else
    echo "Not currently running."
fi

sleep 2
